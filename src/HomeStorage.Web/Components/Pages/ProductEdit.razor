@page "/products/{id:guid}/edit"
@using System.Text.Json
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;
@inject NavigationManager _navigation;

<PageTitle>Edit Product</PageTitle>

<div class="page-head">
    <div>
        <h1>Edit product</h1>
        <p class="page-sub">Update the details of this item.</p>
    </div>
</div>

@if (Product is not null)
{
    <div class="form-card">
        <EditForm Model="Product" FormName="ProductEditForm" OnValidSubmit="Submit">
            <div class="mb-3">
                <label class="form-label">@nameof(Product.Name)</label>
                <InputText @bind-Value="Product.Name" class="form-control"></InputText>
            </div>
            <div class="mb-3">
                <label class="form-label">@nameof(Product.Description)</label>
                <InputText @bind-Value="Product.Description" class="form-control"></InputText>
            </div>
            <div class="mb-3">
                <label class="form-label">@nameof(Product.Producer)</label>
                <InputText @bind-Value="Product.Producer" class="form-control"></InputText>
            </div>
            <div class="mb-3">
                <label class="form-label">@nameof(Product.Quantity)</label>
                <InputNumber @bind-Value="Product.Quantity" class="form-control"></InputNumber>
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <InputSelect @bind-Value="Product.LocationId" class="form-select">
                    <option value="0" disabled>-- Select location --</option>
                    @foreach (var location in _locations)
                    {
                        <option value="@location.Id">@location.LocationName</option>
                    }
                </InputSelect>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-warning">@_error</div>
            }

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a href="/products" class="btn btn-secondary">Cancel</a>
            </div>
        </EditForm>
    </div>
}
else
{
    <p class="muted-note">Loading product…</p>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProductDto? Product { get; set; }
    private List<LocationDto> _locations = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var locationsResponse = await _httpClient.GetAsync("/locations");
        if (locationsResponse.IsSuccessStatusCode)
        {
            var content = await locationsResponse.Content.ReadAsStringAsync();
            _locations = JsonSerializer.Deserialize<List<LocationDto>>(content) ?? [];
        }

        var productResponse = await _httpClient.GetAsync($"/products/{Id}");
        if (productResponse.IsSuccessStatusCode)
        {
            var content = await productResponse.Content.ReadAsStringAsync();
            Product = JsonSerializer.Deserialize<ProductDto>(content);
        }
    }

    private async Task Submit()
    {
        _error = null;
        if (Product!.LocationId == 0)
        {
            _error = "Please select a location.";
            return;
        }

        var response = await _httpClient.PutAsJsonAsync($"/products/{Id}", Product);
        if (response.IsSuccessStatusCode)
        {
            _navigation.NavigateTo("/products");
        }
        else
        {
            _error = "Could not update the product.";
        }
    }
}
