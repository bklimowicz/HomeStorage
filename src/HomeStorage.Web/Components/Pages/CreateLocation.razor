@page "/locations/create"
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;
@inject NavigationManager _navigation;

<PageTitle>Create Location</PageTitle>

<div class="page-head">
    <div>
        <h1>Create location</h1>
        <p class="page-sub">Add a room, shelf or box to store things in.</p>
    </div>
</div>

<div class="form-card">
    <EditForm Model="Location" FormName="LocationCreateForm" OnValidSubmit="Submit">
        <div class="mb-3">
            <label class="form-label">@nameof(Location.LocationName)</label>
            <InputText @bind-Value="Location.LocationName" class="form-control" placeholder="e.g. Kitchen Pantry"></InputText>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create location</button>
            <a href="/locations" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    private LocationDto Location { get; set; } = new();

    private async Task Submit()
    {
        var response = await _httpClient.PostAsJsonAsync("/locations", Location);
        if (response.IsSuccessStatusCode)
        {
            _navigation.NavigateTo("/locations");
        }
    }
}
