@page "/locations/create"
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;
@inject NavigationManager _navigation;

<PageTitle>Create Location</PageTitle>

<h3>Create Location</h3>

<EditForm Model="Location" FormName="LocationCreateForm" OnValidSubmit="Submit">
    <div class="row mb-3">
        <div class="col-2">
            <label class="col-form-label">@nameof(Location.LocationName)</label>
        </div>
        <div class="col-6">
            <InputText @bind-Value="Location.LocationName" class="form-control"></InputText>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
    <a href="/locations" class="btn btn-secondary">Back to Locations</a>
</EditForm>

@code {
    private LocationDto Location { get; set; } = new();

    private async Task Submit()
    {
        var response = await _httpClient.PostAsJsonAsync("/locations", Location);
        if (response.IsSuccessStatusCode)
        {
            _navigation.NavigateTo("/locations");
        }
    }
}
