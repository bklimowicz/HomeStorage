@page "/locations"
@using System.Text.Json
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;

<PageTitle>Locations</PageTitle>

<div class="page-head">
    <div>
        <h1>Locations</h1>
        <p class="page-sub">Rooms, shelves and boxes you store things in.</p>
    </div>
    <a href="/locations/create" class="btn btn-primary">＋ Create location</a>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-warning">@_error</div>
}

@if (_locations is null)
{
    <p class="muted-note">Loading locations…</p>
}
else if (!_locations.Any())
{
    <div class="empty-state">
        <span class="empty-icon">🗺️</span>
        <p>No locations yet.</p>
        <a href="/locations/create" class="btn btn-primary">Add your first location</a>
    </div>
}
else
{
    <div class="card">
        <table class="table mb-0">
            <thead>
            <tr>
                <th>Name</th>
                <th class="text-end">Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var location in _locations)
            {
                <tr>
                    <td class="align-middle">@location.LocationName</td>
                    <td class="text-end">
                        <a href="/locations/@location.Id/edit" class="btn btn-sm btn-secondary">Edit</a>
                        <button class="btn btn-sm btn-danger" @onclick="() => Delete(location.Id)">Delete</button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@code {
    private List<LocationDto>? _locations;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var response = await _httpClient.GetAsync("/locations");
        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            _locations = JsonSerializer.Deserialize<List<LocationDto>>(content) ?? [];
        }
    }

    private async Task Delete(int id)
    {
        _error = null;
        var response = await _httpClient.DeleteAsync($"/locations/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
        else
        {
            _error = "Cannot delete a location that still has products assigned.";
        }
    }
}
