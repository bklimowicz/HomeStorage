@page "/"

<PageTitle>Home</PageTitle>

<section class="hero">
    <span class="hero-eyebrow">Home inventory</span>
    <h1 class="hero-title">Know <span class="grad">what</span> you store<br/>and <span class="grad">where</span> it lives.</h1>
    <p class="hero-lead">A clean, no-friction catalogue of everything in your home — organised by the places you keep it.</p>

    <div class="hero-actions">
        <a href="/products" class="btn btn-primary">Browse products</a>
        <a href="/locations" class="btn btn-secondary">Manage locations</a>
    </div>
</section>

<div class="feature-grid">
    <a href="/products" class="feature-card">
        <span class="feature-icon">📦</span>
        <span class="feature-title">Products</span>
        <span class="feature-desc">Add items with quantity, producer and the location they belong to.</span>
    </a>
    <a href="/locations" class="feature-card">
        <span class="feature-icon">🗺️</span>
        <span class="feature-title">Locations</span>
        <span class="feature-desc">Define rooms, shelves and boxes, then assign products to them.</span>
    </a>
    <a href="/products/create" class="feature-card">
        <span class="feature-icon">＋</span>
        <span class="feature-title">Quick add</span>
        <span class="feature-desc">Jump straight to creating a new product in seconds.</span>
    </a>
</div>
