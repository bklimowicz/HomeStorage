@page "/products/create"
@using System.Text.Json
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;
@inject NavigationManager _navigation;

<PageTitle>Create Product</PageTitle>

<div class="page-head">
    <div>
        <h1>Create product</h1>
        <p class="page-sub">Add a new item to your inventory.</p>
    </div>
</div>

<div class="form-card">
    <EditForm Model="Product" FormName="ProductCreateForm" OnValidSubmit="Submit">
        <div class="mb-3">
            <label class="form-label">@nameof(Product.Name)</label>
            <InputText @bind-Value="Product.Name" class="form-control" placeholder="e.g. Flour"></InputText>
        </div>
        <div class="mb-3">
            <label class="form-label">@nameof(Product.Description)</label>
            <InputText @bind-Value="Product.Description" class="form-control" placeholder="Optional details"></InputText>
        </div>
        <div class="mb-3">
            <label class="form-label">@nameof(Product.Producer)</label>
            <InputText @bind-Value="Product.Producer" class="form-control" placeholder="Optional"></InputText>
        </div>
        <div class="mb-3">
            <label class="form-label">@nameof(Product.Quantity)</label>
            <InputNumber @bind-Value="Product.Quantity" class="form-control"></InputNumber>
        </div>
        <div class="mb-3">
            <label class="form-label">Location</label>
            <InputSelect @bind-Value="Product.LocationId" class="form-select">
                <option value="0" disabled>-- Select location --</option>
                @foreach (var location in _locations)
                {
                    <option value="@location.Id">@location.LocationName</option>
                }
            </InputSelect>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-warning">@_error</div>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create product</button>
            <a href="/products" class="btn btn-secondary">Cancel</a>
        </div>
    </EditForm>
</div>

@code {
    private ProductDto Product { get; set; } = new();
    private List<LocationDto> _locations = [];
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var response = await _httpClient.GetAsync("/locations");
        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            _locations = JsonSerializer.Deserialize<List<LocationDto>>(content) ?? [];
        }
    }

    private async Task Submit()
    {
        _error = null;
        if (Product.LocationId == 0)
        {
            _error = "Please select a location.";
            return;
        }

        var response = await _httpClient.PostAsJsonAsync("/products", Product);
        if (response.IsSuccessStatusCode)
        {
            _navigation.NavigateTo("/products");
        }
        else
        {
            _error = "Could not create the product.";
        }
    }
}
