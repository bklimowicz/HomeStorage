@page "/products"
@using System.Text.Json
@using HomeStorage.Web.Model.DTOs
@rendermode InteractiveServer
@inject HttpClient _httpClient;

<PageTitle>Products</PageTitle>

<div class="page-head">
    <div>
        <h1>Products</h1>
        <p class="page-sub">Everything you keep, and where it lives.</p>
    </div>
    <a href="/products/create" class="btn btn-primary">＋ Create product</a>
</div>

@if (_products is null)
{
    <p class="muted-note">Loading products…</p>
}
else if (!_products.Any())
{
    <div class="empty-state">
        <span class="empty-icon">📦</span>
        <p>No products yet.</p>
        <a href="/products/create" class="btn btn-primary">Add your first product</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach(var product in _products)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@product.Name</span>
                    <span class="qty-pill">@product.Quantity</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@(string.IsNullOrWhiteSpace(product.Description) ? "—" : product.Description)</h5>
                    @if (!string.IsNullOrWhiteSpace(product.Producer))
                    {
                        <p class="card-text"><span class="meta-label">Producer</span> @product.Producer</p>
                    }
                    <p class="card-text"><span class="meta-label">Location</span> <span class="loc-tag">@product.LocationName</span></p>
                    <div class="card-actions">
                        <a href="/products/@product.Id/edit" class="btn btn-secondary btn-sm">Edit</a>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(product.Id)">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}

@code {
    private List<ProductDto>? _products;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var response = await _httpClient.GetAsync("/products");

        if (response.IsSuccessStatusCode)
        {
            var content = await response.Content.ReadAsStringAsync();
            _products = JsonSerializer.Deserialize<List<ProductDto>>(content) ?? [];
        }
    }

    private async Task Delete(Guid? id)
    {
        var response = await _httpClient.DeleteAsync($"/products/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAsync();
        }
    }
}