# Copy to infrastructure/.env and fill in. Do NOT commit the real .env.

# PostgreSQL password (used by the db and by the API connection string).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels -> create -> copy token).
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Container images built by GitHub Actions and pushed to GHCR.
# Set to your GHCR namespace, i.e. ghcr.io/<your-github-username-or-org>.
IMAGE_PREFIX=ghcr.io/your-github-username
IMAGE_TAG=latest
